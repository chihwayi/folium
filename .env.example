# Copy to .env and fill in real values locally. Real values in production
# live in the Coolify service's environment config — never in this repo.

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (Sprint 0) ---
# Postgres connection string, provisioned as a Coolify service.
DATABASE_URL="postgres://user:password@localhost:5432/folium"

# --- Search (Sprint 0 / used from Sprint 2) ---
# Meilisearch instance, provisioned as a Coolify service.
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY=""

# --- Auth.js (Sprint 1) ---
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Optional Google OAuth for customer sign-in
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Email (Sprint 1 / Resend) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Folium <no-reply@example.com>"

# --- Object storage (Sprint 4 / Cloudflare R2, cover images) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# --- Payments (Sprint 3 / Stripe, test mode until Sprint 7) ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
